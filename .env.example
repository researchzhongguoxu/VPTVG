VISION_PROVIDER=qwen
VISION_MODEL=qwen3.6-flash
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY_ENV=DASHSCOPE_API_KEY

DASHSCOPE_API_KEY=your_qwen_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.6-flash

PLANNER_PROVIDER=deepseek
PLANNER_MODEL=deepseek-v4-pro
PLANNER_BASE_URL=https://api.deepseek.com
PLANNER_API_KEY_ENV=DEEPSEEK_API_KEY

# Qwen planner option for math-chain experiments:
# PLANNER_PROVIDER=qwen
# PLANNER_MODEL=qwen3.6-plus
# PLANNER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# PLANNER_API_KEY_ENV=DASHSCOPE_API_KEY

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

TTS_PROVIDER=volcengine
TTS_BASE_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
TTS_RESOURCE_ID=seed-tts-2.0
TTS_VOICE_TYPE=your_chinese_voice_type_here
TTS_VOICE_TYPE_ZH=your_chinese_voice_type_here
TTS_VOICE_TYPE_EN=your_english_voice_type_here
TTS_AUDIO_FORMAT=wav
TTS_SAMPLE_RATE=24000
TTS_SPEED_RATIO=0.9
TTS_API_KEY=your_volcengine_tts_api_key_here
TTS_AUTH_MODE=auto
TTS_APP_ID=your_volcengine_tts_app_id_here
TTS_ACCESS_TOKEN=your_volcengine_tts_access_token_here

# International endpoint option:
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# MLLM video ablation judges. GLM and Qwen are enabled by the ablation script by default;
# Doubao and Kimi are reserved for optional later runs.
JUDGE_PROVIDERS=qwen,glm,kimi
JUDGE_FRAME_STRATEGY=scene_start_mid
JUDGE_MIN_FRAMES=6
JUDGE_MAX_FRAMES=12
JUDGE_USE_TRANSCRIPT=1

JUDGE_QWEN_MODEL=qwen3.6-plus
JUDGE_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
JUDGE_QWEN_API_KEY_ENV=DASHSCOPE_API_KEY

JUDGE_GLM_MODEL=glm-4.6v
JUDGE_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
JUDGE_GLM_API_KEY_ENV=ZAI_API_KEY
ZAI_API_KEY=your_zai_api_key_here

JUDGE_DOUBAO_MODEL=your_ark_endpoint_or_model_id_here
JUDGE_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
JUDGE_DOUBAO_API_KEY_ENV=ARK_API_KEY
ARK_API_KEY=your_volcengine_ark_key_here

JUDGE_KIMI_MODEL=kimi-k2.6
JUDGE_KIMI_BASE_URL=https://api.moonshot.cn/v1
JUDGE_KIMI_API_KEY_ENV=KIMI_API_KEY
MOONSHOT_API_KEY=your_moonshot_key_here
